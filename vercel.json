{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [{
    "source": "/(.*)",
    "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
  }],
  "rewrites": [
    { "source": "/", "destination": "/api/home" },
    { "source": "/api/restore/:noteId", "destination": "/api/restore" },
    { "source": "/api/notes/:id", "destination": "/api/note" },
    { "source": "/api/announcements/:id", "destination": "/api/announcement" }
  ],
  "functions": { "api/home.js": { "includeFiles": "views/index.html" } }
}
